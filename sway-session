#!/bin/bash

stop() {
    systemctl --user --job-mode=replace-irreversibly start \
        sway-session-shutdown.target
}

start() {
    systemctl --user --quiet is-active sway-session.target && exit 1
    trap stop EXIT
    systemctl --user reset-failed
    systemctl --user --wait start \
        sway-session.target
}

status() {
    systemctl --user is-active \
        sway-session.target
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 <start|stop|status>" >&2
        exit 1
        ;;
esac
